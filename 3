import random

def guess_the_number():
    number = random.randint(0, 9)
    attempts = 3

    print("Гра 'Вгадай число'! Я загадав число від 0 до 9. У тебе є 3 спроби, щоб його вгадати.")

    for attempt in range(1, attempts + 1):
        try:
            guess = int(input(f"Спроба {attempt}: Введи число від 0 до 9: "))
        except ValueError:
            print("Будь ласка, введи ціле число.")
            continue

        if guess < 0 or guess > 9:
            print("Число поза межами діапазону. Спробуйте ще раз.")
            continue

        if guess == number:
            print("Вітаю! Ви вгадали число!")
            break
        elif guess < number:
            print("Загадане число більше.")
        else:
            print("Загадане число менше.")
    else:
        print(f"На жаль, ви не вгадали. Загадане число було: {number}")

if __name__ == "__main__":
    guess_the_number()
